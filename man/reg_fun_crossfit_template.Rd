n_seg <- 300
x <- rbind(
  matrix(rnorm(n_seg * 5, mean = 0, sd = 0.5), n_seg, 5),
  matrix(rnorm(n_seg * 5, mean = 4, sd = 0.5), n_seg, 5),
  matrix(rnorm(n_seg * 5, mean = -4, sd = 0.5), n_seg, 5)
